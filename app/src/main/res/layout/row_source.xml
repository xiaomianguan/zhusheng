<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:minHeight="56dp"
    android:gravity="center_vertical"
    android:paddingTop="6dp"
    android:paddingBottom="6dp"
    android:paddingLeft="4dp"
    android:paddingRight="4dp"
    android:background="?attr/zsBackground">

    <CheckBox
        android:id="@+id/row_check"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:clickable="false" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="4dp">

        <TextView
            android:id="@+id/row_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/zsTextPrimary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/row_url"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="?attr/zsTextSecondary"
            android:textSize="10sp"
            android:singleLine="true"
            android:ellipsize="middle" />

        <TextView
            android:id="@+id/row_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/zs_ok"
            android:textSize="11sp" />
    </LinearLayout>

</LinearLayout>
