    <!-- ================================================= accent, dark scheme -->

    <!--
      The same accents for the dark color scheme, in the 200 tints - the very step
      Material itself takes with its own accent (deep teal 500 in a light theme,
      deep teal 200 in a dark one, see AppColors.defaultAccent). A 500 accent is hard
      to read against dark surfaces, which is what the tint is there for.
    -->

    <style name="ThemeOverlay.Zhusheng.Material.Accent.Red.Dark" parent="">
        <item name="android:colorAccent">@color/mat_red_200</item>
        <item name="android:colorControlActivated">@color/mat_red_200</item>
