<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!--
      The colors offered by the Material theme's two pickers.

      Each of these is layered on top of the Material theme with
      Theme.applyStyle() (see AppColors.applyTheme) instead of replacing it, so
      everything the app does not name here - the dialogs, the widgets, the text
      colors - keeps following the framework Material theme.

      The styles deliberately carry no parent: an overlay must add only the
      attributes listed below.

      android:colorPrimary / colorPrimaryDark color the action bar and the status
      bar; android:colorAccent / colorControlActivated color the check boxes, the
      progress bar, the dialog buttons and the text selection handles.
    -->

    <!-- ============================================================= primary -->

    <style name="ThemeOverlay.Zhusheng.Material.Primary.Red" parent="">
        <item name="android:colorPrimary">@color/mat_red</item>
        <item name="android:colorPrimaryDark">@color/mat_red_dark</item>
    </style>

    <style name="ThemeOverlay.Zhusheng.Material.Primary.Pink" parent="">
        <item name="android:colorPrimary">@color/mat_pink</item>
        <item name="android:colorPrimaryDark">@color/mat_pink_dark</item>
    </style>

    <style name="ThemeOverlay.Zhusheng.Material.Primary.Purple" parent="">
        <item name="android:colorPrimary">@color/mat_purple</item>
        <item name="android:colorPrimaryDark">@color/mat_purple_dark</item>
    </style>

