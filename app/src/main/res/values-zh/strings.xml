    <string name="status_removing_user">正在从用户证书库移除 %1$d 张证书…</string>
    <string name="status_remove_system_done">已从 /system/etc/security/cacerts 移除 %1$d 张证书。重启后生效。</string>
    <string name="status_remove_system_done_deduped">已从 /system/etc/security/cacerts 移除 %1$d 张证书，并把证书库中存在多份的 %2$d 个根证书缩减为一份。重启后生效。</string>
    <string name="status_remove_system_deduped_only">已把证书库中存在多份的 %1$d 个根证书缩减为一份。原先受信任的证书仍然全部受信任。</string>
